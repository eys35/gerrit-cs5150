# Example environment for scripts/daily-offline-ingest.sh (and systemd
# gerrit-offline-ingest.service). Copy to /etc/default/gerrit-offline-ingest
# and adjust paths; chmod 600 if it contains secrets.

# Required
GERRIT_URL=https://review.example.com

# Gerrit site path for gerrit-maintenance -d
GERRIT_SITE=/var/gerrit

# --- Laptop / non-root quick test (uncomment) ---
# Defaults put the DB and JSON under GERRIT_SITE/data/, which needs root if
# GERRIT_SITE is /var/gerrit. Point them somewhere writable instead:
# INGEST_DB=${TMPDIR:-/tmp}/reviewer-activity.db
# EXTERNAL_ACTIVITY_JSON=${TMPDIR:-/tmp}/external-activity.json
# GERRIT_SITE must still be a real site tree (etc/gerrit.config + git repos)
# unless you set OFFLINE_INGEST_PROJECTS so ingest does not need to walk git/.

# Optional HTTP basic auth for Gerrit REST
# GERRIT_HTTP_USER=robot
# GERRIT_HTTP_PASSWORD=...

# SQLite store and JSON snapshot (match gerrit.config [algorithmicReviewer] externalActivityFile)
# INGEST_DB=/var/gerrit/data/reviewer-activity.db
# EXTERNAL_ACTIVITY_JSON=/var/gerrit/data/external-activity.json

# Optional: limit which projects are ingested (space-separated; passed as -p)
# OFFLINE_INGEST_PROJECTS=myproject otherproject

# Optional: skip projects (space-separated; passed as --skip)
# OFFLINE_INGEST_SKIP=All-Users

# Optional GitHub backfill (same DB, source=github). Needs a PAT for sane rate limits.
# GITHUB_TOKEN=ghp_...
# GITHUB_REPOS="myorg/repo-a myorg/repo-b"
# Or ingest by mapped logins from the identity map instead of a fixed repo list:
# GITHUB_INGEST_BY_USER=1
# GITHUB_IDENTITY_MAP=/var/gerrit/maintenance/conf/github_users.json
