# One-shot offline ingest + export for the algorithmic reviewer.
#
# Install (adjust paths and user):
#   sudo cp contrib/maintenance/systemd/gerrit-offline-ingest.{service,timer} /etc/systemd/system/
#   sudo cp contrib/maintenance/conf/daily-offline-ingest.env.example /etc/default/gerrit-offline-ingest
#   # edit /etc/default/gerrit-offline-ingest and WorkingDirectory / ExecStart below
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now gerrit-offline-ingest.timer

[Unit]
Description=Gerrit offline reviewer-activity ingest and external-activity export
Documentation=https://gerrit.googlesource.com/gerrit/+/master/contrib/maintenance/README.md

[Service]
Type=oneshot
User=gerrit
Group=gerrit

# Install location of contrib/maintenance (contains gerrit-maintenance.py).
WorkingDirectory=/var/gerrit/maintenance

EnvironmentFile=-/etc/default/gerrit-offline-ingest
ExecStart=/var/gerrit/maintenance/scripts/daily-offline-ingest.sh

# Hardening (relax if your layout requires broader filesystem access)
PrivateTmp=true
NoNewPrivileges=true
