# Runs gerrit-offline-ingest.service once per calendar day (after midnight,
# with optional jitter). Override OnCalendar if you need a fixed wall-clock time.

[Unit]
Description=Daily timer for Gerrit offline reviewer-activity ingest

[Timer]
OnCalendar=daily
AccuracySec=1h
RandomizedDelaySec=45min
Persistent=true

[Install]
WantedBy=timers.target
